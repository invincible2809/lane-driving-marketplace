# Copy to your hosting provider's environment settings. Never commit real secrets.

# Database (added automatically by the Turso integration on Vercel)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=              # SECRET

# Public origin of the site. Google's redirect URI must be exactly APP_URL/auth/google/callback
APP_URL=https://srkdrivingschool.co.uk

# business = SRK public website at /, learner portal at /account, admin at /app
SITE_MODE=business
# Workspace shown on the public site (optional when only one workspace exists)
SITE_WORKSPACE_ID=
# Only these Google accounts may create the instructor workspace (comma-separated)
OWNER_EMAILS=owner@example.com
# Platform support administrator (read-only overview)
ADMIN_EMAIL=

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=          # SECRET

# Email: preview (nothing sent, shown under Settings > Sent emails) or resend
EMAIL_MODE=preview
RESEND_API_KEY=                # SECRET
EMAIL_FROM="SRK Driving School <lessons@your-verified-domain>"
# Route every email to one safe inbox while testing
EMAIL_REDIRECT_TO=

# Bearer secret for an external scheduler calling POST /api/jobs/run
JOB_SECRET=                    # SECRET
# Sent by Vercel Cron with its GET /api/jobs/run call
CRON_SECRET=                   # SECRET

# Keep false unless the host injects trusted oai-authenticated-* identity headers (Sites hosting)
TRUST_PLATFORM_IDENTITY=false
# Legacy learner marketplace (frozen)
MARKETPLACE_ENABLED=false
